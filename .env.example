# Supabase (Project Settings > API). A anon key é pública; protegida por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# E-mail interno da conta do painel (login usa só senha + TOTP). Definido no servidor, nunca exposto ao navegador.
ADMIN_EMAIL=painel@exemplo.com

# SOMENTE para scripts locais do implantador (scripts/create-admin.mjs). Nunca em hospedagem pública.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (canônicas, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Opcional: avaliações oficiais via Google Places API (New)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
