# Supabase (Project Settings > API). A anon key é pública; protegida por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# SOMENTE para scripts locais do implantador (scripts/create-admin.mjs). Nunca em hospedagem pública.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (canônicas, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br


# Opcional: código de verificação do Google Search Console (método "tag HTML", somente o valor de content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
